---
import SectionPage from '../../components/SectionPage.astro';
import { registry, productsFor, pagesCount } from '../../lib/data';
export function getStaticPaths() {
  const out: any[] = [];
  for (const p of registry.filter((r) => r.url.startsWith('/catalog/'))) {
    const rel = p.url === '/catalog/' ? '' : p.url.replace(/^\/catalog\//, '').replace(/\/$/, '');
    out.push({ params: { path: rel || undefined }, props: { url: p.url, page: 1 } });
    const n = pagesCount(productsFor(p.url).length);
    for (let i = 2; i <= n; i++) out.push({ params: { path: (rel ? rel + '/' : '') + `page-${i}` }, props: { url: p.url, page: i } });
  }
  return out;
}
const { url, page } = Astro.props;
---
<SectionPage url={url} page={page} />
