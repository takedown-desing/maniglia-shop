---
import SectionPage from '../../../components/SectionPage.astro';
import { registry, seriesTexts, isEmptyPage } from '../../../lib/data';
export function getStaticPaths() {
  return registry.filter((p) => p.type === 'series' && !isEmptyPage(p.url)).map((p) => ({ params: { slug: p.url.split('/')[2] }, props: { url: p.url } }));
}
const { url } = Astro.props;
const s = seriesTexts.get(url.split('/')[2]);
---
<SectionPage url={url} override={s ? { title: s.title, description: s.description, h1: s.name, text: s.text } : undefined} />
