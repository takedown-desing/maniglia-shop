---
import Base from '../../layouts/Base.astro';
import SectionPage from '../../components/SectionPage.astro';
import Listing from '../../components/Listing.astro';
import Prose from '../../components/Prose.astro';
import { registry, regByUrl, brandTexts, productsFor, children, breadcrumbs, seriesTexts, isIndexable, SITE_NAME, firstImage, pagesCount } from '../../lib/data';
import { u, abs } from '../../lib/url';
export function getStaticPaths() {
  const out: any[] = [];
  for (const p of registry.filter((r) => r.type === 'brand' || r.type === 'brand-category')) {
    const rel = p.url.replace(/^\/brands\//, '').replace(/\/$/, '');
    out.push({ params: { path: rel }, props: { url: p.url, page: 1 } });
    const n = pagesCount(productsFor(p.url).length);
    for (let i = 2; i <= n; i++) out.push({ params: { path: `${rel}/page-${i}` }, props: { url: p.url, page: i } });
  }
  return out;
}
const { url, page } = Astro.props as { url: string; page: number };
const reg = regByUrl.get(url)!;
const slug = url.split('/')[2];
const bt = brandTexts.get(slug);
const isBrand = reg.type === 'brand';
const bcKey = url.split('/')[3];
const bcText = !isBrand ? bt?.categories?.[bcKey] : undefined;
const items = productsFor(url);
const cats = isBrand ? children(url, ['brand-category']) : [];
const series = isBrand ? registry.filter((p) => p.type === 'series' && p.url.split('/')[2].startsWith(slug + '-')) : [];
const name = bt?.name || reg.h1.replace('Дверная фурнитура ', '');
const FOUNDED_OK = ['agb', 'krona-koblenz', 'colombo-design', 'tupai', 'pamar', 'otlav', 'comaglio', 'verum', 'fantom'];
const founded = FOUNDED_OK.includes(slug) && bt?.founded ? `основан в ${bt.founded} г.` : '';
---
{isBrand ? (
  <Base title={page > 1 ? `${reg.h1}: страница ${page} из ${pagesCount(items.length)}` : (bt?.title || `${name}: дверная фурнитура, купить в ${SITE_NAME}`)} description={bt?.description || `${reg.h1}: каталог, цены, доставка по России.`} path={page > 1 ? `${url}page-${page}/` : url} crumbs={breadcrumbs(url)} noindex={!isIndexable(url)} image={items.map(firstImage).find(Boolean)}
    schema={[{ '@type': 'Brand', name, url: abs(Astro.site, url) }, { '@type': 'CollectionPage', name: reg.h1, url: abs(Astro.site, url) }]}>
    <div class="wrap">
      <div class="page-head">
        <h1>{reg.h1}{page > 1 ? `, страница ${page}` : ''}</h1>
        <p class="lead">{[bt?.country, founded, bt?.segment].filter(Boolean).join(' · ')}{bt?.tagline ? `. ${bt.tagline}` : ''}</p>
      </div>
      {cats.length > 0 && <div class="chips">{cats.map((c) => <a class="chip" href={u(c.url)}>{c.h1.replace(' ' + name, '')}</a>)}</div>}
      {series.length > 0 && <div class="chips">{series.map((s) => <a class="chip" href={u(s.url)}>Серия {seriesTexts.get(s.url.split('/')[2])?.name || s.h1}</a>)}</div>}
      <Listing items={items} page={page} baseUrl={url} />
      {page === 1 && <section class="section"><Prose md={bt?.text} /></section>}
    </div>
  </Base>
) : (
  <SectionPage url={url} page={page} override={bcText ? { ...bcText, h1: reg.h1 } : undefined} />
)}
