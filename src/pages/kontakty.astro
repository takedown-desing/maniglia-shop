---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { COMPANY, tel, mapSrc } from '../lib/company';
import { SITE_NAME } from '../lib/data';
import { u, abs } from '../lib/url';
const schema = [{
  '@type': 'Store', name: SITE_NAME, legalName: COMPANY.legalName, url: abs(Astro.site, '/'), telephone: COMPANY.phoneMain, email: COMPANY.email,
  address: { '@type': 'PostalAddress', streetAddress: COMPANY.address.replace(/^Москва, /, ''), addressLocality: 'Москва', addressCountry: 'RU' },
  geo: { '@type': 'GeoCoordinates', latitude: COMPANY.geo.lat, longitude: COMPANY.geo.lon }, openingHours: COMPANY.hoursSchema,
}, { '@type': 'ContactPage', name: `Контакты ${SITE_NAME}`, url: abs(Astro.site, '/kontakty/') }];
---
<Base title={`Контакты магазина дверной фурнитуры ${SITE_NAME}: адрес, телефон, шоурум`} description={`Адрес шоурума ${SITE_NAME} в Москве, телефоны, e-mail, режим работы, схема проезда и реквизиты компании.`} path="/kontakty/" schema={schema} crumbs={[{ url: '/', name: 'Главная' }, { url: '/kontakty/', name: 'Контакты' }]}>
  <div class="wrap">
    <div class="page-head"><h1>Контакты</h1><p class="lead">Шоурум и склад в Москве, доставка по всей России. Позвоните, напишите в мессенджер или приезжайте посмотреть образцы покрытий вживую.</p></div>
    <div class="contact-grid">
      <div>
        <dl class="kv">
          <dt>Телефон</dt><dd><a href={tel(COMPANY.phoneMain)} style="font-size:20px">{COMPANY.phoneMain}</a><br /><small style="color:var(--c-muted)">{COMPANY.phoneMainNote}</small></dd>
          <dt>Мессенджеры</dt><dd><a href={tel(COMPANY.phoneMobile)}>{COMPANY.phoneMobile}</a><br /><small style="color:var(--c-muted)">{COMPANY.phoneMobileNote}</small></dd>
          <dt>E-mail</dt><dd><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a> · заказы<br /><a href={`mailto:${COMPANY.emailOpt}`}>{COMPANY.emailOpt}</a> · опт и дилеры</dd>
          <dt>Адрес</dt><dd>{COMPANY.address}<br /><small style="color:var(--c-muted)">{COMPANY.showroom}</small></dd>
          <dt>Как добраться</dt><dd>{COMPANY.metro}. Бесплатная парковка для клиентов у входа.</dd>
          <dt>Режим работы</dt><dd>{COMPANY.hours.map((h) => <div>{h.d}: {h.t}</div>)}</dd>
        </dl>
        <div class="aside-box" style="margin-top:26px">
          <h3>Самовывоз</h3>
          <p style="font-size:14.5px;color:var(--c-text-2)">Заказ, оформленный до 14:00, обычно готов к выдаче в тот же день, если товар есть на складе. Дождитесь сообщения о готовности и возьмите с собой номер заказа.</p>
        </div>
      </div>
      <div>
        <iframe class="map" src={mapSrc(16)} title={`Карта: ${COMPANY.address}`} loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
        <p style="font-size:13px;color:var(--c-muted);margin-top:8px">Карта Яндекса. Нажмите на метку, чтобы построить маршрут.</p>
      </div>
    </div>

    <section class="section">
      <h2>Реквизиты</h2>
      <div class="btable"><table><tbody>
        <tr><th scope="row">Полное наименование</th><td>{COMPANY.legalName}</td></tr>
        <tr><th scope="row">ИНН / КПП</th><td>{COMPANY.inn} / {COMPANY.kpp}</td></tr>
        <tr><th scope="row">ОГРН</th><td>{COMPANY.ogrn}</td></tr>
        <tr><th scope="row">Юридический и фактический адрес</th><td>{COMPANY.address}</td></tr>
        <tr><th scope="row">Банк</th><td>{COMPANY.bank}</td></tr>
      </tbody></table></div>
      <p class="bnote">Демо-реквизиты: компания вымышленная, данные приведены для примера оформления страницы.</p>
    </section>

    <section class="section">
      <h2>Написать нам</h2>
      <form class="form" data-demo-form>
        <label class="sr-only" for="n">Имя</label><input id="n" name="name" placeholder="Имя" required />
        <label class="sr-only" for="ph">Телефон</label><input id="ph" name="phone" placeholder="Телефон" type="tel" required />
        <label class="sr-only" for="m">Сообщение</label><textarea id="m" name="msg" placeholder="Что нужно подобрать? Можно приложить размеры двери"></textarea>
        <button class="btn btn-accent" type="submit">Отправить</button>
        <p style="font-size:13px;color:var(--c-muted)">Демо: форма не отправляет данные.</p>
      </form>
    </section>
  </div>
  <script>
    document.querySelectorAll<HTMLFormElement>('[data-demo-form]').forEach((f) => f.addEventListener('submit', (e) => { e.preventDefault(); f.innerHTML = '<p>Спасибо! В рабочей версии заявка уйдёт менеджеру.</p>'; }));
  </script>
</Base>
